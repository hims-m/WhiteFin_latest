# Copy to ".env" in this folder to customise. Every value is optional.

# --- Optional LLM (the app works fully without one) -------------------------
# Option A: fully local & free. Install Ollama (https://ollama.com), run
#   ollama pull llama3.2
# then uncomment:
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434
#
# Option B: Google Gemini free tier — https://aistudio.google.com/app/apikey
# Model names get retired; check https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Data ---------------------------------------------------------------------
# Force synthetic demo data (no internet needed). Leave off for real data.
WHITEFIN_OFFLINE=0
MARKET_CACHE_TTL_HOURS=6
HISTORY_PERIOD=5y
STOCK_UNIVERSE=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS,HINDUNILVR.NS,ITC.NS,KOTAKBANK.NS,LT.NS,SBIN.NS,BHARTIARTL.NS,ASIANPAINT.NS,MARUTI.NS,TITAN.NS,SUNPHARMA.NS
GOLD_TICKER=GOLDBEES.NS
BENCHMARK_TICKER=^NSEI

# --- Capital-market assumptions (India, long run) ------------------------------
RISK_FREE_RATE=0.065
MARKET_EXPECTED_RETURN=0.12
INFLATION_RATE=0.055

# --- Server -------------------------------------------------------------------
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./whitefin.db
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,null
